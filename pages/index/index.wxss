.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.compose-canvas {
  position: fixed;
  left: 0;
  top: 0;
  width: 750rpx;
  height: 750rpx;
  opacity: 0;
  pointer-events: none;
  z-index: -1;
}

.card-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 16rpx;
}

.hint {
  font-size: 24rpx;
  color: #95a5a6;
  font-weight: normal;
}

.input-area {
  width: 100%;
  min-height: 280rpx;
  max-height: 480rpx;
  padding: 16rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  box-sizing: border-box;
  border: 2rpx solid #e9ecef;
}

.btn-row {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  flex-wrap: wrap;
}

.btn {
  flex: 1;
  min-width: 140rpx;
  margin: 0 !important;
  border-radius: 40rpx !important;
  padding: 0 24rpx !important;
}

.btn.primary {
  background: #3498db !important;
  color: #fff !important;
  border: none !important;
}

.btn.ghost {
  background: #f1f3f5 !important;
  color: #495057 !important;
  border: none !important;
}

.date-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  background: #f8f9fa;
  border: 2rpx solid #e9ecef;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
}

.date-label {
  font-size: 24rpx;
  color: #2c3e50;
  font-weight: 600;
}

.date-value {
  min-width: 220rpx;
  text-align: right;
  font-size: 24rpx;
  color: #3498db;
  font-weight: 600;
}

.hint-block {
  margin-top: 14rpx;
  color: #6c757d;
  font-size: 22rpx;
  line-height: 1.5;
}

.attendance-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #495057;
}

.attendance-absent {
  color: #b02a37;
}

.attendance-list {
  max-height: 520rpx;
  overflow: auto;
  border: 2rpx solid #e9ecef;
  border-radius: 12rpx;
  background: #fff;
}

.attendance-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 16rpx;
  border-bottom: 1rpx solid #eef1f4;
}

.attendance-item:last-child {
  border-bottom: none;
}

.attendance-name {
  font-size: 24rpx;
  color: #2c3e50;
}

.attendance-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 18rpx;
  border: 2rpx solid transparent;
}

.attendance-tag.present {
  color: #166534;
  background: #dcfce7;
  border-color: #86efac;
}

.attendance-tag.absent {
  color: #9f1239;
  background: #ffe4e6;
  border-color: #fda4af;
}

.unmatched-box {
  margin-top: 12rpx;
  background: #fff8e1;
  border: 2rpx solid #ffe08a;
  border-radius: 10rpx;
  padding: 12rpx;
}

.unmatched-title {
  display: block;
  font-size: 22rpx;
  color: #8a5a00;
  margin-bottom: 6rpx;
}

.unmatched-text {
  display: block;
  font-size: 22rpx;
  color: #6f4a00;
  line-height: 1.5;
}

.pacer-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.pacer-item {
  background: #f8f9fa;
  border: 2rpx solid #e9ecef;
  border-radius: 12rpx;
  padding: 14rpx;
}

.pacer-label {
  display: block;
  font-size: 24rpx;
  color: #2c3e50;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.pacer-input {
  width: 100%;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  color: #495057;
}

.group-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.group-item {
  background: #f8f9fa;
  border-left: 8rpx solid #3498db;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
}

.group-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 12rpx;
  gap: 16rpx;
}

.group-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #2c3e50;
}

.group-count {
  font-size: 24rpx;
  color: #3498db;
  background: rgba(52, 152, 219, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.group-summary {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.group-brief {
  display: block;
  max-width: 420rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #6c757d;
  text-align: right;
}

.members {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.member {
  display: inline-block;
  background: #fff;
  color: #495057;
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  border: 2rpx solid #e9ecef;
}

.member-pacer {
  background: #ffe58f;
  border-color: #f2c94c;
  color: #5f4b00;
  font-weight: 600;
}

.image-wrap {
  width: 100%;
  max-height: 800rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  overflow: hidden;
}

.result-image {
  width: 100%;
  display: block;
}

.code-box {
  background: #2c3e50;
  color: #ecf0f1;
  font-family: Menlo, Consolas, monospace;
  font-size: 22rpx;
  line-height: 1.6;
  padding: 20rpx;
  border-radius: 12rpx;
  max-height: 600rpx;
  overflow: auto;
  word-break: break-all;
  white-space: pre-wrap;
}

.debug-box {
  background: #111827;
  border-radius: 12rpx;
  padding: 16rpx;
  max-height: 360rpx;
  overflow: auto;
}

.debug-line {
  display: block;
  font-family: Menlo, Consolas, monospace;
  font-size: 20rpx;
  line-height: 1.5;
  color: #d1d5db;
  white-space: pre-wrap;
  word-break: break-all;
  margin-bottom: 6rpx;
}

.debug-empty {
  display: block;
  font-size: 22rpx;
  color: #9ca3af;
}
